---
import ThemeToggle from "@/components/ThemeToggle.vue"
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/Layout.astro"
import { organizationSchema, websiteSchema } from "@/lib/schema"

const home = new URL("/", Astro.site)
const schema = [websiteSchema(home), organizationSchema(home)]
---

<Layout schema={schema}>
  <header class="container mx-auto flex items-center justify-between px-6 py-4">
    <a href="/" class="font-semibold">pocket-astro</a>
    <ThemeToggle client:load />
  </header>
  <main class="container mx-auto px-6 py-24 text-center">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">Astro + PocketBase + Vue</h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-muted-foreground">
      Server-rendered pages for SEO, Vue islands with shadcn-vue, and an SPA cabinet on the same components.
    </p>
    <div class="mt-10 flex justify-center gap-3">
      <a href="/app" class={buttonVariants()}>Open app</a>
      <a href="https://github.com/k2so-dev/pocket-astro" class={buttonVariants({ variant: "outline" })}>GitHub</a>
    </div>
  </main>
</Layout>

---
import type { Thing, WithContext } from "schema-dts"
import JsonLd from "@/components/seo/JsonLd.astro"
import { site } from "@/site"

export interface Props {
  title?: string
  description?: string
  image?: string
  type?: "website" | "article"
  noindex?: boolean
  schema?: WithContext<Thing> | WithContext<Thing>[]
}

const { title, description = site.description, image = site.image, type = "website", noindex, schema } = Astro.props
const fullTitle = title ? `${title} | ${site.name}` : site.name
const canonical = new URL(Astro.url.pathname, Astro.site)
const imageUrl = image ? new URL(image, Astro.site).href : undefined
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
{site.twitter && <meta name="twitter:site" content={site.twitter} />}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
<link rel="sitemap" href="/sitemap-index.xml" />
{schema && <JsonLd schema={schema} />}
